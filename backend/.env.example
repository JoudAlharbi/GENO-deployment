# Portfolio demo (default) — no PostgreSQL or login required
DEMO_MODE=true
FLASK_DEBUG=false
CORS_ORIGINS=*

# Optional: persistent uploads + demo analyses on Render disk (recommended)
# DATA_DIR=/var/data
# DEMO_STORE_PATH=/var/data/demo/demo_store.json

PORT=5000

# --- Full production mode (set DEMO_MODE=false) ---
# DEMO_MODE=false
# SECRET_KEY=change-this-to-a-long-random-string
# DATABASE_URL=postgresql://user:pass@host:5432/geno
# DB_HOST=127.0.0.1
# DB_NAME=geno
# DB_USER=postgres
# DB_PASSWORD=geno
# DB_PORT=5432
# Demo login seed (create_test_users.py): demo / demo1234
# DEMO_EMPLOYEE_ID=demo
# DEMO_PASSWORD=demo1234
# DEMO_USER_ID=demo
