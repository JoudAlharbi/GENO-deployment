# Copy to backend/.env — never commit .env

# PostgreSQL (local)
DB_HOST=127.0.0.1
DB_NAME=geno
DB_USER=postgres
DB_PASSWORD=geno
DB_PORT=5432

# Or use hosted Postgres URL (Render/Neon/Railway) — overrides DB_* when set
# DATABASE_URL=postgresql://user:pass@host:5432/geno

SECRET_KEY=change-this-to-a-long-random-string
JWT_EXPIRATION_HOURS=24
FLASK_DEBUG=false
FLASK_DEBUG_REQUESTS=false

# Public demo user (run: python create_test_users.py)
# DEMO_EMPLOYEE_ID=DEMO01
# DEMO_PASSWORD=demo123

# Production CORS — your live frontend URL(s), comma-separated
# CORS_ORIGINS=https://your-geno-app.vercel.app,http://localhost:5173

# Optional: persistent data directory (Render disk mount path)
# DATA_DIR=/var/data

# Port (Render/Railway set PORT automatically)
PORT=5000
