# Portfolio demo (default) — no PostgreSQL or login required
DEMO_MODE=true
FLASK_DEBUG=false
CORS_ORIGINS=*

# Free-tier compatible demo persistence
# - Seed store (tracked in repo): backend/demo/demo_store.json
# - Runtime store (ephemeral writes): {DATA_DIR}/demo_runtime_store.json
# DATA_DIR=/tmp/geno
# DEMO_SEED_STORE_PATH=/path/to/backend/demo/demo_store.json
# DEMO_RUNTIME_STORE_PATH=/tmp/geno/demo_runtime_store.json

PORT=5000

# --- Full production mode (set DEMO_MODE=false) ---
# DEMO_MODE=false
# SECRET_KEY=change-this-to-a-long-random-string
# DATABASE_URL=postgresql://user:pass@host:5432/geno
# DB_HOST=127.0.0.1
# DB_NAME=geno
# DB_USER=postgres
# DB_PASSWORD=geno
# DB_PORT=5432
# Demo login seed (create_test_users.py): demo / demo1234
# DEMO_EMPLOYEE_ID=demo
# DEMO_PASSWORD=demo1234
# DEMO_USER_ID=demo
